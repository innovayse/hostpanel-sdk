<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Innovayse.SDK</RootNamespace>

    <!-- This project builds on its own (this repository) and as a git submodule inside the host's
         backend, which manages package versions centrally. The SDK opts out of that and pins its
         own versions below, so both builds restore the same packages. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <!-- Package identity. The version is the contract: bump the minor for an added member,
         the major for a removed or renamed one. .github/workflows/publish.yml pushes a version
         the feed does not have yet and skips one it does, so a change that keeps the version
         publishes nothing. -->
    <PackageId>Innovayse.SDK</PackageId>
    <Version>2.0.0</Version>
    <Authors>Hostpanel contributors</Authors>
    <Copyright>Copyright (c) 2024-2026 the Hostpanel contributors</Copyright>
    <Description>Plugin contracts for hostpanel: provisioning, payment, registrar, identity, fulfilment, hosted and app plugins. MIT licensed, so a plugin may be free or paid, open or closed source.</Description>
    <PackageTags>hostpanel;plugin;sdk;hosting;billing;payment;registrar;provisioning</PackageTags>

    <!-- MIT, unlike the AGPL-3.0 host: a plugin compiled against these contracts is its author's
         to license, free or paid, open or closed. The expression is what NuGet shows; the LICENSE
         file beside this project carries the full text and is packed too. SdkPackageTests in the
         host's Architecture suite pins both. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/innovayse/hostpanel-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/innovayse/hostpanel-sdk.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The lowest versions the contracts need, equal to the host's own pins, so a plugin built
         against the package and the host that loads it agree on them. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>

</Project>
