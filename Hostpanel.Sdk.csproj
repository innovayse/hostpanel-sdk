<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Hostpanel.Sdk</RootNamespace>
    <AssemblyName>Hostpanel.Sdk</AssemblyName>

    <!-- This project builds on its own (this repository) and as a git submodule inside the host's
         backend, which manages package versions centrally. The SDK opts out of that and pins its
         own versions below, so both builds restore the same packages. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <!-- Package identity. The version lives in Directory.Build.props, shared with Hostpanel.Sdk.Packaging. It is the contract: bump the minor for an added member,
         the major for a removed or renamed one. .github/workflows/publish.yml pushes a version
         the feed does not have yet and skips one it does, so a change that keeps the version
         publishes nothing. -->
    <PackageId>Hostpanel.Sdk</PackageId>
    <Authors>Hostpanel contributors</Authors>
    <Copyright>Copyright (c) 2024-2026 the Hostpanel contributors</Copyright>
    <Description>Plugin contracts for hostpanel: provisioning (hosting panels and virtual servers), payment, registrar (domain operations), identity, fulfilment, hosted and app plugins. MIT licensed, so a plugin may be free or paid, open or closed source.</Description>
    <PackageTags>hostpanel;plugin;sdk;hosting;billing;payment;registrar;domains;provisioning;virtual-server</PackageTags>

    <!-- MIT, unlike the AGPL-3.0 host: a plugin compiled against these contracts is its author's
         to license, free or paid, open or closed. The expression is what NuGet shows; the LICENSE
         file beside this project carries the full text and is packed too. SdkPackageTests in the
         host's Architecture suite pins both. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/innovayse/hostpanel-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/innovayse/hostpanel-sdk.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project sits below this one; without this the default globbing would compile it into the package. -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <!-- The packaging project sits below this one for the same reason; it is its own package. -->
    <Compile Remove="Hostpanel.Sdk.Packaging/**" />
    <None Remove="Hostpanel.Sdk.Packaging/**" />
    <!-- The source generator is its own project, built for the compiler and not part of this assembly. -->
    <Compile Remove="Hostpanel.Sdk.Generators/**" />
    <None Remove="Hostpanel.Sdk.Generators/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runs inside this project's own build (it prints the records marked [SecretMember]) and ships in the package under
         analyzers, so a plugin that marks a member of its own record gets the same code. It adds no reference to the assembly. -->
    <ProjectReference Include="Hostpanel.Sdk.Generators/Hostpanel.Sdk.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

  <!-- Adds the generator's own output to the package, wherever the build put it: the project is asked for its target path, so
       no output folder, configuration or target framework is written here. -->
  <Target Name="PackGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="Hostpanel.Sdk.Generators/Hostpanel.Sdk.Generators.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="GeneratorOutput" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(GeneratorOutput)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The lowest versions the contracts need, equal to the host's own pins, so a plugin built
         against the package and the host that loads it agree on them. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>

</Project>
